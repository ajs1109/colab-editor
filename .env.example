# Copy to .env.local and fill in your own values. Never commit real keys.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Resend (https://resend.com) - used to email project invitations
RESEND_API_KEY=your-resend-api-key
